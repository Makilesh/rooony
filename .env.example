# --- extraction + embedding ------------------------------------------------
GEMINI_API_KEY=

# sqlite (default, no server needed) | actian
VECTOR_BACKEND=sqlite

# where the DB and the captured JPEGs live
MEM_DIR=~/mem

# --- Actian VectorAI (only when VECTOR_BACKEND=actian) ---------------------
# local docker instance, gRPC endpoint (docker compose up -d)
VECTORAI_HOST=localhost:6574
VECTORAI_COLLECTION=screen_activity

# NOTE: there is deliberately no EMBED_MODEL / EMBED_DIM here. Both live in
# embed.py (gemini-embedding-001, 768) and src/config.py imports them. Two
# definitions is how the query side and the write side end up on different
# models, which makes every cosine score meaningless without erroring.
