# Actian VectorAI DB (local docker instance) — gRPC endpoint
VECTORAI_HOST=localhost:6574

# Collection name your teammates' capture/embedding pipeline writes to
VECTORAI_COLLECTION=screen_activity

# Embedding model used for the QUERY side (must match whatever your teammates
# use to embed screenshots/captions on the write side, or results won't compare
# meaningfully). Placeholder until they confirm theirs.
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBED_DIM=384
